# GAPAK frontend runtime configuration
# Leave API_BASE_URL empty in Vite development: `/api/v1` is proxied to the
# local backend. For a separately deployed API, set its origin, for example
# `https://api.example.com` (without `/api/v1`).
VITE_API_BASE_URL=""
VITE_DEV_API_TARGET="http://127.0.0.1:8080"
VITE_WS_BASE_URL=""
VITE_MEDIA_BASE_URL=""
VITE_ENVIRONMENT="development"

# Development only. Production builds always disable mock API access.
VITE_ENABLE_MOCK_API="false"
VITE_ENABLE_PLATFORM_SANDBOX="true"
