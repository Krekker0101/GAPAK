{
  "name": "gapak-front",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "test:static": "node --test --experimental-strip-types tests/*.test.ts",
    "test": "npm run typecheck && npm run lint && npm run test:all",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "test:e2e": "playwright test",
    "perf:audit": "node scripts/performance-audit.mjs",
    "test:unit": "node --test --experimental-strip-types tests/unit/*.test.ts",
    "test:contract": "node --test --experimental-strip-types tests/contract/*.test.ts tests/api-contract.test.ts",
    "test:integration": "node --test --experimental-strip-types tests/integration/*.test.ts",
    "test:security": "node --test --experimental-strip-types tests/security/*.test.ts tests/production-boundary.test.ts",
    "test:performance": "node --test --experimental-strip-types tests/performance/*.test.ts tests/phase5-realtime-performance.test.ts",
    "test:all": "node scripts/run-tests.mjs",
    "ci:verify": "npm run lint && npm run typecheck && npm run test:all && npm run build",
    "test:unit:coverage": "node --test --experimental-strip-types --experimental-test-coverage tests/unit/*.test.ts",
    "test:e2e:required": "GAPAK_E2E_BASE_URL=${GAPAK_E2E_BASE_URL:?GAPAK_E2E_BASE_URL is required} GAPAK_E2E_AUTH_URL=${GAPAK_E2E_AUTH_URL:?GAPAK_E2E_AUTH_URL is required} playwright test"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "motion": "^12.23.24",
    "@tanstack/react-query": "^5.85.5",
    "react-router-dom": "^7.8.2",
    "hls.js": "^1.5.20"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@playwright/test": "^1.55.0"
  }
}
