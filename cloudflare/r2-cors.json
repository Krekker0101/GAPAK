{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://gapak.vercel.app",
          "http://localhost:3000",
          "http://localhost:3002"
        ],
        "methods": [
          "GET",
          "HEAD",
          "PUT"
        ],
        "headers": [
          "Content-Type",
          "Range"
        ]
      },
      "exposeHeaders": [
        "Accept-Ranges",
        "Content-Length",
        "Content-Range",
        "ETag"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}
