APP_NAME=Gapak API
APP_ENV=production
APP_BASE_URL=https://YOUR-RAILWAY-DOMAIN
APP_HOST=0.0.0.0
APP_PORT=${PORT}
CORS_ORIGINS=https://YOUR-VERCEL-DOMAIN
AUTO_MIGRATE=false
DATABASE_URL=${{Postgres.DATABASE_PRIVATE_URL}}
REDIS_ENABLED=true
REDIS_URL=${{Redis.REDIS_PRIVATE_URL}}
METRICS_ENABLED=true
METRICS_TOKEN=GENERATE-A-RANDOM-SECRET
JWT_ISSUER=gapak.api
JWT_AUDIENCE=gapak.clients
JWT_ACCESS_SECRET=GENERATE-A-RANDOM-SECRET
JWT_REFRESH_SECRET=GENERATE-A-DIFFERENT-RANDOM-SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
PASSWORD_PEPPER=GENERATE-A-RANDOM-SECRET
ENCRYPTION_KEY_BASE64=GENERATE-32-BYTE-BASE64-KEY
COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
REFRESH_COOKIE_NAME=gapak_rt
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=https://7aa6a9e1c9548cf14963c1d8c59edfc1.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=SET-IN-RAILWAY-AS-A-SECRET
STORAGE_SECRET_ACCESS_KEY=SET-IN-RAILWAY-AS-A-SECRET
STORAGE_BUCKET=gapak-media-prod
STORAGE_SIGNED_URL_TTL=15m
STORAGE_UPLOAD_INTENT_TTL=2h
STORAGE_PLAYBACK_GRANT_TTL=15m
STORAGE_MULTIPART_PART_SIZE_BYTES=8388608
STORAGE_MAX_UPLOAD_BYTES=1073741824
STORAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,video/mp4,video/webm,audio/mpeg,audio/mp4,audio/ogg,audio/webm
STORAGE_SIGNING_SECRET=GENERATE-A-RANDOM-SECRET
MEDIA_FFMPEG_TIMEOUT=30m
MEDIA_FFMPEG_MAX_DURATION=2h
MEDIA_FFMPEG_MAX_OUTPUT_BYTES=1073741824
MEDIA_FFMPEG_THREADS=2
MEDIA_FFMPEG_CONCURRENCY=2
ANONYMITY_HASH_SECRET=GENERATE-A-RANDOM-SECRET

# Browser destination after successful OAuth callback. Must be an allowed frontend origin.
OAUTH_FRONTEND_REDIRECT_URL=
