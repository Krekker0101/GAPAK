APP_NAME=Gapak API
APP_ENV=development
POSTGRES_PASSWORD=replace-with-local-db-password
MINIO_ROOT_PASSWORD=replace-with-local-minio-password
AUTO_MIGRATE=false
APP_BASE_URL=http://localhost:8080
APP_HOST=0.0.0.0
APP_PORT=8080
CORS_ORIGINS=http://localhost:3000

# Cloud PostgreSQL (Prisma Data Proxy) example:
# DATABASE_URL=postgres://user:password@db.prisma.io:5432/postgres?sslmode=require
#
# Local PostgreSQL example:
# DATABASE_URL=postgresql://postgres:5433@127.0.0.1:5432/gapak?sslmode=disable
# Previous example: postgresql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/gapak?sslmode=disable
#
# Docker Compose overrides DATABASE_URL to use the postgres service name.
# For running binaries directly on the host, use 127.0.0.1.
DATABASE_URL=postgresql://gapak:${POSTGRES_PASSWORD}@127.0.0.1:5432/gapak?sslmode=disable
MIGRATIONS_DIR=db/migrations
DATABASE_MAX_OPEN_CONNS=20
DATABASE_MIN_OPEN_CONNS=5
DATABASE_MAX_CONN_LIFETIME=30m

REDIS_URL=redis://redis:6379/5

JWT_ISSUER=gapak.api
JWT_AUDIENCE=gapak.clients
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
PASSWORD_PEPPER=replace-with-random-password-pepper
ENCRYPTION_KEY_BASE64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Production on different sites (for example Vercel frontend + Railway API) must use:
# CORS_ORIGINS=https://gapak.vercel.app
# APP_BASE_URL=https://gapak-api-production.up.railway.app
# COOKIE_DOMAIN=
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none
REFRESH_COOKIE_NAME=gapak_rt
CSRF_COOKIE_NAME=gapak_csrf

ANONYMITY_ENABLED=true
ANONYMITY_REQUIRE_PSEUDONYMOUS_SIGNUP=true
ANONYMITY_ALLOW_ANONYMOUS_SIGNUP=true
ANONYMITY_ALLOW_EMAIL_SIGNUP=false
ANONYMITY_ALLOW_PASSWORD_RECOVERY=false
ANONYMITY_TRUST_PROXY_HEADERS=true
ANONYMITY_PROXY_HEADERS=CF-Connecting-IP,X-Forwarded-For,X-Real-IP
ANONYMITY_HASH_SECRET=replace-with-32-byte-random-secret
ANONYMITY_STORE_IP=false
ANONYMITY_STORE_USER_AGENT=false
ANONYMITY_STORE_DEVICE_FINGERPRINT=false
ANONYMITY_LOG_NETWORK_METADATA=false
ANONYMITY_EXPOSE_EMAIL_IN_RESPONSES=false

STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=gapak
STORAGE_SECRET_ACCESS_KEY=replace-with-storage-secret
STORAGE_BUCKET=gapak-private
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/api/v1/media/gateway
STORAGE_PROTECTED_BASE_URL=http://localhost:8080/api/v1/media/protected
STORAGE_PUBLIC_CDN_BASE_URL=
STORAGE_PROTECTED_CDN_BASE_URL=
STORAGE_SIGNED_URL_TTL=15m
STORAGE_UPLOAD_INTENT_TTL=30m
STORAGE_PLAYBACK_GRANT_TTL=5m
STORAGE_SIGNING_SECRET=replace-with-random-storage-signing-secret
STORAGE_MULTIPART_PART_SIZE_BYTES=8388608
STORAGE_MAX_UPLOAD_BYTES=26214400
STORAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,video/mp4,application/pdf

QUEUE_MEDIA_PROCESSING=queue:media:processing
QUEUE_STORY_PROCESSING=queue:story:processing
QUEUE_LIVE_REPLAY=queue:live:replay
QUEUE_CLEANUP=queue:cleanup
QUEUE_LIVE_EVENTS=realtime:live-events
QUEUE_CLAIM_TTL=5m

WORKER_POLL_INTERVAL=2s
WORKER_BATCH_SIZE=10
WORKER_MEDIA_CONCURRENCY=4
STORY_DEFAULT_TTL=24h
LIVE_REPLAY_RETENTION=720h

RATE_LIMIT_GLOBAL_WINDOW=1m
RATE_LIMIT_GLOBAL_MAX=120
RATE_LIMIT_AUTH_WINDOW=5m
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_PASSWORD_WINDOW=15m
RATE_LIMIT_PASSWORD_MAX=5

# OAuth Social Login
# Google: https://console.cloud.google.com/apis/credentials
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=

# GitHub: https://github.com/settings/applications/new
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URI=

# Facebook: https://developers.facebook.com/apps/
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
OAUTH_FACEBOOK_REDIRECT_URI=
MEDIA_FFMPEG_TIMEOUT=20m
MEDIA_FFMPEG_MAX_DURATION=2h
MEDIA_FFMPEG_MAX_OUTPUT_BYTES=1073741824
MEDIA_FFMPEG_THREADS=2
MEDIA_FFMPEG_CONCURRENCY=2
WORKER_MEDIA_CLEANUP_INTERVAL=30m

# Observability
METRICS_ENABLED=true
METRICS_TOKEN=change-me-in-production
WORKER_METRICS_PORT=9091

# Browser destination after successful OAuth callback. Must be an allowed frontend origin.
OAUTH_FRONTEND_REDIRECT_URL=

# Push notifications (optional; enable one or more providers in the worker)
PUSH_ENABLED=true
PUSH_PROVIDERS=
PUSH_WORKER_POLL_INTERVAL=2s
PUSH_WORKER_BATCH_SIZE=20
PUSH_WORKER_MAX_ATTEMPTS=8
PUSH_WORKER_BASE_RETRY=5s
PUSH_WORKER_MAX_RETRY=30m
PUSH_WEBPUSH_VAPID_SUBJECT=
PUSH_WEBPUSH_VAPID_PUBLIC_KEY=
PUSH_WEBPUSH_VAPID_PRIVATE_KEY_PEM=
PUSH_WEBPUSH_AUDIENCE=
PUSH_FCM_PROJECT_ID=
PUSH_FCM_CLIENT_EMAIL=
PUSH_FCM_PRIVATE_KEY_PEM=
PUSH_FCM_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
PUSH_FCM_API_BASE_URL=https://fcm.googleapis.com/v1/projects
PUSH_APNS_TEAM_ID=
PUSH_APNS_KEY_ID=
PUSH_APNS_PRIVATE_KEY_PEM=
PUSH_APNS_BUNDLE_ID=
PUSH_APNS_PRODUCTION=true
